generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StudentEnquiry {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  track     String
  createdAt DateTime @default(now())
}

model Student {
  id                  String                  @id @default(cuid())
  fullName            String
  email               String                  @unique
  matricPin           Int                     @unique
  passwordHash        String
  track               String
  role                String                  @default("STUDENT")
  campusCohortBatch   String                  @default("IBADAN-RING-ROAD-C04")
  bursaryAuditNote    String?
  isVerified          Boolean                 @default(false)
  acceptedTermsAt     DateTime                @default(now())
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  sessions            Session[]
  tuitionPayments     TuitionPayment[]
  paymentAttempts     TuitionPaymentAttempt[]
  verificationCodes   VerificationCode[]

  @@index([track])
}

model Session {
  id         String   @id @default(cuid())
  studentId  String
  tokenHash  String   @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([expiresAt])
}

model TuitionPayment {
  id                String   @id @default(cuid())
  studentId         String
  studentEmail      String
  cohortCode        String   @default("COHORT-04")
  amountKobo        Int
  installmentPhase  String
  paystackReference String   @unique
  paidAt            DateTime @default(now())

  student           Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([paidAt])
}

model TuitionPaymentAttempt {
  id                String   @id @default(cuid())
  studentId         String
  studentEmail      String
  amountKobo        Int
  providerReference String   @unique
  channel           String   @default("BANK_TRANSFER")
  status            String
  failureReason     String?
  ipAddress         String?
  attemptedAt       DateTime @default(now())

  student           Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, attemptedAt])
  @@index([status])
  @@index([studentEmail])
}

model SyllabusChunk {
  id            String   @id @default(cuid())
  track         String
  documentTitle String
  chunkIndex    Int
  content       String
  tokenCount    Int
  embeddingJson String?
  updatedAt     DateTime @updatedAt

  @@unique([documentTitle, chunkIndex])
  @@index([track])
}

model VerificationCode {
  id        String    @id @default(cuid())
  studentId String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, code])
}
