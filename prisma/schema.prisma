generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Preserved from Task 2/3 for backward compatibility
model StudentEnquiry {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  track     String
  createdAt DateTime @default(now())
}

// 1. People who use the system (Tekrise Academy Students)
model Student {
  id                  String                  @id @default(cuid())
  fullName            String
  email               String                  @unique
  matricPin           Int                     @unique
  passwordHash        String
  track               String
  role                String                  @default("STUDENT")
  campusCohortBatch   String
  bursaryAuditNote    String?
  isVerified          Boolean                 @default(false)
  acceptedTermsAt     DateTime                @default(now())
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  sessions            Session[]
  tuitionPayments     TuitionPayment[]
  paymentAttempts     TuitionPaymentAttempt[]
  verificationCodes   VerificationCode[]

  @@index([track])
}

// 2. Their sessions (Server-side session store)
model Session {
  id         String   @id @default(cuid())
  studentId  String
  tokenHash  String   @unique
  ipAddress  String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([expiresAt])
}

// 3A. Money table (Confirmed tuition installment payments in Kobo)
model TuitionPayment {
  id                String   @id @default(cuid())
  studentId         String
  studentEmail      String   // Duplicated deliberately for immutable tax/audit ledger even if Student email changes
  cohortCode        String   @default("COHORT-04")
  amountKobo        Int      // Stored in Kobo (e.g. 15000000 = ₦150,000.00) to avoid floating-point rounding errors
  installmentPhase  String   // "FIRST_60_PERCENT" or "SECOND_40_PERCENT"
  paystackReference String   @unique
  paidAt            DateTime @default(now())

  student           Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([paidAt])
}

// 3B. Money-attempts table (Every initiated, failed, abandoned, or network-dropped payment attempt)
model TuitionPaymentAttempt {
  id                String   @id @default(cuid())
  studentId         String
  studentEmail      String   // Duplicated deliberately as point-in-time snapshot of payer email
  amountKobo        Int
  providerReference String   @unique
  channel           String   @default("BANK_TRANSFER") // "USSD", "CARD", "BANK_TRANSFER"
  status            String   // "INITIATED", "FAILED", "ABANDONED", "NETWORK_DROP", "SUCCEEDED"
  failureReason     String?
  ipAddress         String?
  attemptedAt       DateTime @default(now())

  student           Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId, attemptedAt])
  @@index([status])
}

// 4. Chunks for the Tekrise Academy Syllabus & Policy RAG retrieval system
model SyllabusChunk {
  id            String   @id @default(cuid())
  track         String
  documentTitle String
  chunkIndex    Int
  content       String
  tokenCount    Int
  embeddingJson String?  // Serialized vector embedding for cohort Q&A retrieval
  updatedAt     DateTime @updatedAt

  @@unique([documentTitle, chunkIndex])
  @@index([track])
}

// 5. Email Verification Codes (6-digit cryptographic OTPs)
model VerificationCode {
  id        String    @id @default(cuid())
  studentId String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, code])
}